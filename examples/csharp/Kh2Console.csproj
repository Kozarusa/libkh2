<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain .NET console host of libkh2 through unity/Kh2.cs (P/Invoke), without Unity.
       Build the release DLL first; see examples/csharp/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);KH2_NO_UNITY</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../target/csharp/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../target/csharp/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Kh2.cs" Link="Kh2.cs" />
    <None Include="../../target/release/kh2.dll" Link="kh2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../target/release/kh2.dll')" />
  </ItemGroup>
</Project>
